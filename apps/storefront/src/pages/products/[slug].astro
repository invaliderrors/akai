---
import { sanitizeRichText } from "@akai/rich-text";

import AddToCart from "@/components/islands/AddToCart";
import { t } from "@/i18n/messages";
import Base from "@/layouts/Base.astro";
import { getProduct } from "@/lib/catalog";
import { serverEnv } from "@/lib/env";
import { mediaAlt } from "@/lib/view";

const product = await getProduct(Astro.params.slug ?? "");

if (product === null) {
  return Astro.rewrite("/404");
}

const { name, shortDescription, description } = product;
const gallery = [...product.media].sort((a, b) => a.sortOrder - b.sortOrder);
---

<Base title={name} description={shortDescription || undefined}>
  <article class="mx-auto grid max-w-7xl gap-10 px-4 pt-10 sm:px-6 lg:grid-cols-[3fr_2fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        gallery.map((media, index) => (
          <img
            src={media.url}
            alt={mediaAlt(media, name)}
            width={media.width}
            height={media.height}
            loading={index < 2 ? "eager" : "lazy"}
            class:list={["w-full border border-ink bg-line object-cover", index === 0 && "sm:col-span-2"]}
          />
        ))
      }
    </div>

    <div class="lg:sticky lg:top-28 lg:h-fit">
      <h1 class="font-display text-5xl uppercase leading-none">{name}</h1>
      {shortDescription && <p class="mt-4 text-stone">{shortDescription}</p>}

      <div class="mt-8">
        <AddToCart
          client:load
          apiUrl={serverEnv().PUBLIC_API_URL}
          variants={product.variants}
          cartHref={"/cart"}
          t={t.product}
          errors={t.errors}
        />
      </div>

      {
        description && (
          <section class="mt-10 border-t border-ink pt-6">
            <h2 class="label">{t.product.description}</h2>
            <div class="rich-text text-sm leading-relaxed" set:html={sanitizeRichText(description)} />
          </section>
        )
      }
    </div>
  </article>
</Base>
