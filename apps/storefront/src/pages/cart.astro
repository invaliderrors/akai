---
import CartView from "@/components/islands/CartView";
import { t } from "@/i18n/messages";
import Base from "@/layouts/Base.astro";
import { serverEnv } from "@/lib/env";

---

<Base title={t.cart.title}>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <h1 class="mb-10 font-display text-6xl uppercase">{t.cart.title}</h1>
    <CartView
      client:only="react"
      apiUrl={serverEnv().PUBLIC_API_URL}
      shopHref={"/products"}
      checkoutHref={"/checkout"}
      productHrefBase={"/products"}
      t={t.cart}
      problems={t.cartProblems}
    />
  </section>
</Base>
