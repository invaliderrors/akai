---
import Categories from "@/components/home/Categories.astro";
import Hero from "@/components/home/Hero.astro";
import Offer from "@/components/home/Offer.astro";
import ProductGrid from "@/components/home/ProductGrid.astro";
import Reviews from "@/components/home/Reviews.astro";
import Base from "@/layouts/Base.astro";
import { getFreeShippingThreshold, listCategories, listProducts } from "@/lib/catalog";
import { cheapestPrice } from "@/lib/view";

const [newest, bestsellers, categories, freeShipping] = await Promise.all([
  listProducts({ sort: "newest", limit: 8 }),
  listProducts({ sort: "best_selling", limit: 8 }),
  listCategories(),
  getFreeShippingThreshold(),
]);
const hero = newest.items[0] ?? null;
const heroPrice = hero === null ? null : cheapestPrice(hero);
---

<Base thread>
  <Hero product={hero} />
  <div data-thread="R" aria-hidden="true" class="spacer"></div>
  <Categories categories={categories} />
  <div data-thread=".45" aria-hidden="true" class="spacer"></div>
  <ProductGrid newest={newest.items} bestsellers={bestsellers.items} />
  <div data-thread=".5" aria-hidden="true" class="spacer"></div>
  <Offer
    examplePrice={heroPrice === null ? null : { amount: heroPrice.gross, currency: heroPrice.currency }}
    freeShipping={freeShipping}
  />
  <Reviews />
  <div data-thread=".5" aria-hidden="true" class="h-[clamp(40px,6vw,80px)]"></div>
</Base>

<style>
  .spacer {
    height: clamp(64px, 9vw, 120px);
  }
</style>

<script>
  import "@/scripts/thread";
</script>
