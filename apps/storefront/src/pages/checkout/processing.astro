---
import OrderProcessing from "@/components/islands/OrderProcessing";
import { t } from "@/i18n/messages";
import Base from "@/layouts/Base.astro";
import { serverEnv } from "@/lib/env";
import { wompiTransactionIdFrom } from "@/lib/payment-status";

const orderNumber = Astro.url.searchParams.get("order");

// The API builds this URL (`/checkout/processing?order=…`); anything else is not ours.
if (orderNumber === null || !/^[A-Z]{2}-\d{4}-\d{6}$/.test(orderNumber)) {
  return Astro.redirect("/");
}

// Wompi appends `?id=<transactionId>` on the way back. Shape-checked here; a
// missing or malformed id just means the page polls without the shortcut.
const transactionId = wompiTransactionIdFrom(Astro.url.searchParams.get("id"));
---

<Base title={t.processing.title}>
  <section class="mx-auto max-w-2xl px-4 pt-16 sm:px-6">
    <h1 class="mb-8 font-display text-5xl uppercase">{t.processing.title}</h1>
    <OrderProcessing client:only="react" apiUrl={serverEnv().PUBLIC_API_URL} orderNumber={orderNumber} transactionId={transactionId} t={t.processing} />
  </section>
</Base>
