---
import CheckoutForm from "@/components/islands/CheckoutForm";
import { t } from "@/i18n/messages";
import Base from "@/layouts/Base.astro";
import { serverEnv } from "@/lib/env";
import { TERMS_VERSION } from "@/lib/legal";

---

<Base title={t.checkout.title}>
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <h1 class="mb-10 font-display text-6xl uppercase">{t.checkout.title}</h1>
    <CheckoutForm
      client:only="react"
      apiUrl={serverEnv().PUBLIC_API_URL}
      cartHref={"/cart"}
      termsVersion={TERMS_VERSION}
      t={t.checkout}
      errors={t.errors}
    />
  </section>
</Base>
