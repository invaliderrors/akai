---
import CartCount from "@/components/islands/CartCount";
import { messages } from "@/i18n/messages";
import { alternatePath, href } from "@/i18n/routing";
import { serverEnv } from "@/lib/env";
import { readSession } from "@/lib/session";

const locale = Astro.locals.locale;
const t = messages(locale);
const other = locale === "es" ? "en" : "es";
const env = serverEnv();
const session = await readSession(Astro.cookies);
const dashboard = env.PUBLIC_DASHBOARD_URL.replace(/\/+$/, "") + (locale === "en" ? "/en" : "");
const accountHref = session === null ? `${dashboard}/sign-in` : dashboard;
---

<header class="sticky top-0 z-20 border-b border-ink bg-paper/95 backdrop-blur">
  <div class="bg-akai py-1.5 text-center text-[11px] font-bold uppercase tracking-[0.3em] text-paper">
    赤い · Limited runs · Tokyo
  </div>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6">
    <a href={href(locale, "/")} class="font-display text-3xl leading-none tracking-wide" aria-label="Akai">
      AKAI<span class="text-akai">.</span>
    </a>
    <div class="flex items-center gap-5 text-xs font-bold uppercase tracking-[0.2em]">
      <a href={href(locale, "/products")} class="hover:text-akai">{t.nav.shop}</a>
      <a href={accountHref} class="hidden hover:text-akai sm:inline">
        {session === null ? t.nav.signIn : t.nav.account}
      </a>
      <a href={alternatePath(Astro.url.pathname, locale, other)} class="text-stone hover:text-akai" lang={other}>
        {other.toUpperCase()}
      </a>
      <a href={href(locale, "/cart")} class="flex items-center gap-2 hover:text-akai">
        {t.nav.cart}
        <CartCount client:load apiUrl={env.PUBLIC_API_URL} locale={locale} />
      </a>
    </div>
  </nav>
</header>
