---
import type { PublicProduct } from "@akai/contracts";

import { messages } from "@/i18n/messages";
import { href } from "@/i18n/routing";
import { displayPrice, isSellable, pickLocaleText, primaryMedia, productName } from "@/lib/view";

interface Props {
  product: PublicProduct;
}

const locale = Astro.locals.locale;
const t = messages(locale);
const { product } = Astro.props;
const media = primaryMedia(product);
const name = productName(product, locale);
const price = displayPrice(product, locale);
const soldOut = !product.variants.some(isSellable);
---

<a href={href(locale, `/products/${product.slug}`)} class="group block">
  <div class="relative aspect-[4/5] overflow-hidden border border-ink bg-line">
    {
      media && (
        <img
          src={media.url}
          alt={pickLocaleText(media.alt, locale) ?? name}
          width={media.width}
          height={media.height}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      )
    }
    {
      soldOut && (
        <span class="absolute left-0 top-0 bg-ink px-2 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-paper">
          {t.product.soldOut}
        </span>
      )
    }
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="text-sm font-bold uppercase tracking-wide group-hover:text-akai">{name}</h3>
    {price && <p class="text-sm tabular-nums">{price}</p>}
  </div>
</a>
