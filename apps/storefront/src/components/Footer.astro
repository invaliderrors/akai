---
import { t } from "@/i18n/messages";
import { CATEGORY_SLUGS } from "@/lib/merch";

const f = t.footer;
const shop = "/products";
const category = (slug: string) => `${shop}?category=${slug}`;

interface Link {
  label: string;
  href: string;
  kanji?: string;
}

const columns: { key: string; title: string; links: Link[] }[] = [
  {
    key: "shop",
    title: f.shop,
    links: [
      { label: f.new, href: shop, kanji: "新作" },
      { label: f.tees, href: category(CATEGORY_SLUGS.tees) },
      { label: f.oversized, href: category(CATEGORY_SLUGS.oversized) },
      { label: f.sweatshirts, href: category(CATEGORY_SLUGS.sweatshirts) },
      { label: f.customise, href: "#personaliza" },
    ],
  },
  {
    key: "help",
    title: f.help,
    links: [
      { label: f.sizeGuide, href: "#tallas" },
      { label: f.shipping, href: "#envios" },
      { label: f.returns, href: "#cambios" },
      { label: f.faq, href: "#faq" },
      { label: f.contact, href: "#contacto" },
    ],
  },
  {
    key: "follow",
    title: f.follow,
    links: [
      { label: "Instagram", href: "https://www.instagram.com/akai.wear/" },
      { label: "TikTok", href: "https://www.tiktok.com/@akai.wear" },
      { label: "WhatsApp", href: "https://wa.me/570000000000" },
    ],
  },
];
const external = (url: string) => /^https?:/.test(url);
const legal = [
  { label: f.terms, href: "#terminos" },
  { label: f.privacy, href: "#politica-datos" },
  { label: f.withdrawal, href: "#cambios-retracto" },
  { label: f.pqrs, href: "#pqrs" },
  { label: f.sic, href: "https://www.sic.gov.co/" },
];
const payments = ["PSE", "NEQUI", "BANCOLOMBIA", "VISA", "MASTERCARD"];
const year = new Date().getFullYear();
---

<footer class="footer">
  <i data-thread="L" aria-hidden="true" class="block h-0"></i>
  <div class="join">
    <div>
      <h2 class="join-title">{f.join}<br /><span class="text-akai">{f.thread}</span></h2>
      <p class="join-perk">{f.perk}</p>
    </div>
    <form data-newsletter class="grid min-w-0 gap-3.5">
      <div role="group" aria-label={f.channel} class="channels">
        <button type="button" data-channel="email" aria-pressed="true" class="channel mono">{f.email}</button>
        <button type="button" data-channel="wa" aria-pressed="false" class="channel mono">{f.whatsapp}</button>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <div data-field="email" class="field-wrap">
          <label for="nl-email" class="sr-only">{f.email}</label>
          <input
            id="nl-email"
            type="email"
            required
            autocomplete="email"
            placeholder={f.emailPlaceholder}
            class="nl-input"
          />
        </div>
        <div data-field="wa" hidden class="field-wrap">
          <label for="nl-phone" class="sr-only">{f.whatsapp}</label>
          <div class="nl-phone">
            <span aria-hidden="true" class="nl-prefix">+57</span>
            <input
              id="nl-phone"
              type="tel"
              inputmode="numeric"
              required
              disabled
              autocomplete="tel-national"
              pattern="[0-9 ]{10,13}"
              placeholder="300 000 0000"
            />
          </div>
        </div>
        <span data-submit-wrap class="flex cursor-not-allowed">
          <button type="submit" disabled class="nl-submit" data-done={f.subscribed}>{f.subscribe}</button>
        </span>
      </div>
      <label class="consent">
        <input type="checkbox" required data-consent />
        <span>
          {f.consent}{" "}
          <a href="#politica-datos" class="underline-akai">{f.consentLink}</a>.
        </span>
      </label>
    </form>
  </div>
  <i data-thread="L" aria-hidden="true" class="block h-0"></i>
  <div class="cols">
    <div class="brand">
      <div data-foot-seal class="relative w-24">
        <img src="/brand/akai-tag.png" alt="AKAI" width="232" height="350" class="block h-auto w-24" />
        <svg aria-hidden="true" viewBox="0 0 96 145" class="pointer-events-none absolute left-0 top-0 h-[145px] w-24 overflow-visible">
          <path
            data-knot
            d="M14 0 C36 -12 78 -10 96 8 C110 24 108 66 94 84 C80 97 20 97 4 84 C-10 68 -10 20 10 4 C30 -10 80 -8 100 14 C108 34 106 70 94 86 C90 94 100 99 104 91 C107 84 98 80 94 86 M96 89 C101 99 105 108 102 122 M98 88 C107 93 115 101 118 112"
            pathLength="1"
            fill="none"
            stroke="var(--color-akai)"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </div>
      <div class="mono text-[11px] leading-[1.7] tracking-[.05em]">
        {f.madeIn}<br />4.7110° N, 74.0721° W<br />© AKAI {year}
      </div>
    </div>
    {
      columns.map((column) => (
        <div class="col" data-col>
          <h3 class="col-title mono only-desktop">{column.title}</h3>
          <button type="button" aria-expanded="false" data-col-toggle class="col-toggle mono only-mobile">
            <span>{column.title}</span>
            <span aria-hidden="true" class="text-[18px]" data-sign>+</span>
          </button>
          <ul class="col-links">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="col-link"
                  {...(external(link.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {link.label}
                  {link.kanji !== undefined && <span class="kanji text-[15px]">{link.kanji}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="payments">
    {payments.map((name) => <span class="mono">{name}</span>)}
  </div>
  <div class="border-t border-ink">
    <div class="legal mono">
      <span>{f.legalEntity}</span>
      <nav aria-label={f.legal} class="legal-nav">
        {
          legal.map((link, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={link.href}
                class="legal-link"
                {...(external(link.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {link.label}
              </a>
            </>
          ))
        }
      </nav>
    </div>
  </div>
  <div class="wordmark">
    <svg viewBox="0 0 1000 250" width="100%" preserveAspectRatio="none" aria-hidden="true">
      <text x="0" y="248" textLength="1000" lengthAdjust="spacingAndGlyphs" fill="var(--color-ink)" class="font-display" font-size="272">AKAI</text>
    </svg>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-ink);
    background: var(--color-paper);
  }
  .join {
    max-width: 1280px;
    margin: 0 auto;
    padding: 44px 16px 38px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 28px 56px;
    align-items: center;
    border-bottom: 1px solid var(--color-ink);
  }
  .join-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 7vw, 94px);
    line-height: 0.88;
  }
  .join-perk {
    margin: 16px 0 0;
    font-size: 16px;
    font-weight: 600;
    max-width: 420px;
    line-height: 1.45;
    text-wrap: pretty;
  }
  .channels {
    justify-self: start;
    display: inline-flex;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    padding: 3px;
    gap: 3px;
  }
  .channel {
    height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .channel[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .field-wrap {
    flex: 1 1 240px;
    min-width: 0;
    display: flex;
  }
  .field-wrap[hidden] {
    display: none;
  }
  .nl-input {
    flex: 1;
    min-width: 0;
    height: 56px;
    box-sizing: border-box;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-paper);
    padding: 0 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink);
  }
  .nl-phone {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: stretch;
    height: 56px;
    box-sizing: border-box;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-paper);
    overflow: hidden;
  }
  .nl-prefix {
    display: flex;
    align-items: center;
    padding: 0 12px 0 20px;
    border-right: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
  }
  .nl-phone input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink);
  }
  .nl-submit {
    height: 56px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    background: var(--color-akai);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.2s,
      opacity 0.2s;
  }
  .nl-submit:hover {
    background: var(--color-ink);
  }
  .nl-submit:disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  .consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
    max-width: 540px;
    cursor: pointer;
  }
  .consent input {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--color-akai);
    cursor: pointer;
  }
  .underline-akai {
    text-decoration: underline;
    text-decoration-color: var(--color-akai);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .cols {
    max-width: 1280px;
    margin: 0 auto;
    padding: 34px 16px 26px;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .brand {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  [data-knot] {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.45, 0, 0.2, 1);
  }
  [data-foot-seal][data-drawn] [data-knot] {
    stroke-dashoffset: 0;
  }
  .col {
    min-width: 0;
  }
  .col-title {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .col-toggle {
    width: 100%;
    min-height: 54px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .col-link {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 38px;
    padding: 4px 0;
    box-sizing: border-box;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.15s;
  }
  .col-link:hover,
  .legal-link:hover {
    text-decoration-line: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--color-akai);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }
  .payments {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .payments span {
    border: 1px solid var(--color-ink);
    border-radius: 2px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .legal {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 16px 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 28px;
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
  .legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: center;
  }
  .legal-link {
    color: var(--color-ink);
    text-decoration: none;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .legal-link:hover {
    text-underline-offset: 4px;
  }
  .wordmark {
    height: clamp(56px, 11vw, 150px);
    overflow: hidden;
    border-top: 1px solid var(--color-ink);
  }
  .wordmark svg {
    display: block;
    height: clamp(110px, 24vw, 300px);
  }

  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .brand {
      padding-bottom: 26px;
    }
    .col {
      border-top: 1px solid var(--color-ink);
    }
    .col-links {
      padding-bottom: 14px;
    }
    .col:not([data-open]) .col-links {
      display: none;
    }
    .legal,
    .legal-nav {
      flex-direction: column;
    }
    .legal-nav {
      align-items: flex-start;
    }
  }
</style>

<script>
  // Newsletter: channel switch and consent gate. Only the visible input is
  // enabled, so the hidden one's `required` cannot block the submit.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-newsletter]")) {
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const wrap = form.querySelector<HTMLElement>("[data-submit-wrap]");
    const consent = form.querySelector<HTMLInputElement>("[data-consent]");
    const channels = form.querySelectorAll<HTMLButtonElement>("[data-channel]");
    const fields = form.querySelectorAll<HTMLElement>("[data-field]");

    channels.forEach((channel) =>
      channel.addEventListener("click", () => {
        const mode = channel.dataset.channel;
        channels.forEach((other) => other.setAttribute("aria-pressed", String(other === channel)));
        fields.forEach((field) => {
          const active = field.dataset.field === mode;
          field.hidden = !active;
          field.querySelectorAll("input").forEach((input) => (input.disabled = !active));
        });
      }),
    );

    consent?.addEventListener("change", () => {
      const ok = consent.checked;
      if (submit !== null) submit.disabled = !ok;
      wrap?.classList.toggle("cursor-not-allowed", !ok);
      wrap?.classList.toggle("cursor-pointer", ok);
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (consent?.checked !== true || submit === null) return;
      submit.textContent = submit.dataset.done ?? submit.textContent;
    });
  }

  // Mobile accordion.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-col-toggle]")) {
    toggle.addEventListener("click", () => {
      const col = toggle.closest<HTMLElement>("[data-col]");
      if (col === null) return;
      const open = !col.hasAttribute("data-open");
      col.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      const sign = toggle.querySelector("[data-sign]");
      if (sign !== null) sign.textContent = open ? "−" : "+";
    });
  }

  // The red knot ties itself round the seal when it scrolls into view.
  const seal = document.querySelector<HTMLElement>("[data-foot-seal]");
  if (seal !== null) {
    if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      seal.setAttribute("data-drawn", "");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            setTimeout(() => seal.setAttribute("data-drawn", ""), 350);
            io.disconnect();
          }
        },
        { threshold: 0.6 },
      );
      io.observe(seal);
    }
  }
</script>
