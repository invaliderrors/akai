---
import { messages } from "@/i18n/messages";

const t = messages(Astro.locals.locale);
---

<footer class="mt-24 bg-ink text-paper">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-6">
    <div>
      <p class="font-display text-6xl leading-none">AKAI<span class="text-akai">.</span></p>
      <p class="mt-3 text-sm text-stone">{t.footer.tagline}</p>
    </div>
    <p class="text-xs uppercase tracking-[0.2em] text-stone">
      © {new Date().getFullYear()} Akai. {t.footer.rights}
    </p>
  </div>
</footer>
