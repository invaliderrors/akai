# Copy to .env.local before running `nx run dashboard:dev`.
# Next loads .env.local from the APP directory, not the workspace root, so the
# root .env.example alone is not enough to boot this app locally.

# Server-to-server address of the NestJS API. May be an internal hostname the
# browser cannot resolve — that is the point of the BFF.
API_INTERNAL_URL=http://localhost:3333

# AES-256-GCM key material for the sealed akai_session cookie. REQUIRED:
# `serverEnv()` throws on the first request without it, listing every missing
# key at once. Minimum 32 characters — generate with `openssl rand -base64 48`.
# Rotating it invalidates every session in the fleet (intended break-glass).
SESSION_SECRET=local-development-secret-at-least-32-chars

# Optional; defaults to akai_session.
SESSION_COOKIE_NAME=akai_session

# Browser-reachable API origin. Unused while all traffic goes through the BFF.
NEXT_PUBLIC_API_URL=http://localhost:3333

# Leave EMPTY locally: the Turnstile widget then renders nothing and the forms
# send a self-describing placeholder token, which the API's captcha verifier
# accepts because it fails open when TURNSTILE_SECRET_KEY is unset. Production
# refuses to boot without the secret, so the widget is genuinely enforced there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public origin of the shop, for the account menu's "Back to the shop" row.
# The SAME variable the storefront publishes itself under, so the two cannot
# name different origins for one site. Leave it unset and the row is omitted
# rather than pointing at nothing.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# NOTE: PAYMENTS_ENABLED lives in the ROOT `.env` — it is a server-side decision
# made by the API, not by this app. With it "false" the API settles orders at
# checkout and returns the customer to the ordinary processing screen, so nothing
# here changes: this app cannot tell the difference, which is the point.
