# =============================================================================
# Akai — workspace environment reference. PLACEHOLDERS ONLY.
#
# Copy to `.env` at the workspace root and fill in. Nx loads `.env` for every
# task, so one file serves the API, the worker, both Next apps and the Prisma
# CLI. `.env` is git-ignored; this file is the committed template.
#
# libs/config zod-validates the server variables and throws with the FULL list
# of problems BEFORE listen(), so the API can never boot half-configured.
#
# TWO RULES THAT COST REAL DEBUGGING TIME IF IGNORED:
#
#   1. NEVER set an optional URL variable to an empty string. `SENTRY_DSN=` is
#      not "unset" — it is the empty string, and the schema is
#      `z.string().url().optional()`, which admits `undefined` but rejects "".
#      Leave the line COMMENTED OUT instead. Same for OTEL_EXPORTER_OTLP_ENDPOINT.
#
#   2. The host ports below deliberately avoid the defaults. A developer machine
#      commonly already runs a native PostgreSQL on 5432 and another project's
#      MinIO on 9000. When that happens Docker still reports the port as
#      published while connections reach the OTHER server, and Prisma fails with
#      "P1000 Authentication failed for user akai" against a database that is
#      running perfectly. See docker-compose.yml.
# =============================================================================

# NODE_ENV is deliberately COMMENTED OUT, not set.
#
# Nx injects this file into EVERY task, including Vitest. An uncommented value
# here overrides the NODE_ENV=test that Vitest sets, which flips next/image into
# its development-only strict remote-host validation and fails the storefront's
# product-card tests with "hostname wp.test is not configured under images" — a
# next.config error message for what is purely an environment leak.
#
# libs/config already defaults it to "development", so omitting it is correct.
# Set it explicitly only in a real deployment, where it must be "production".
# NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# --- Database (docker compose: akai-postgres) -------------------------------
# 127.0.0.1, not `localhost`: on Windows `localhost` resolves to ::1 first and
# can reach a native PostgreSQL instead of the container.
# Host port 5434 -> container 5432.
DATABASE_URL=postgresql://akai:akai@127.0.0.1:5434/akai
# Unpooled connection for migrations — must never run through PgBouncer.
DIRECT_DATABASE_URL=postgresql://akai:akai@127.0.0.1:5434/akai

# --- Auth --------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d
# OWASP floor (19 MiB, t=2). The schema enforces the minimum.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# --- Payments ----------------------------------------------------------------
# Whether a real payment provider is engaged at checkout.
#
# "false" is DEMO MODE: checkout skips Wompi, settles the order locally as
# PAID and returns the customer to the ordinary processing screen, which then
# shows the normal confirmation. Orders, confirmation emails, invoices, returns
# and metrics all behave exactly as they do in production — the only thing that
# does not happen is a charge. Use it to show the shop working before any payment
# credentials exist.
#
# PRODUCTION REFUSES "false": marking orders paid without taking money is fraud,
# so libs/config fails the boot rather than letting the flag reach a deployment.
# With "true", all four WOMPI_* keys below are required.
PAYMENTS_ENABLED=true

# --- Wompi (Colombia) -------------------------------------------------------
# Akai takes payment through Wompi WEB CHECKOUT: the API builds a signed
# https://checkout.wompi.co/p/ URL from the order's server-computed total and
# redirects the shopper there. The contract is docs/specs/wompi-integration.md.
#
# WHICH WOMPI ENVIRONMENT THE KEYS BELONG TO: "sandbox" or "live".
#
# NEVER INFERRED FROM NODE_ENV. Unset resolves to sandbox, and NODE_ENV=production
# refuses unset (and refuses "sandbox"). This platform's API may run
# NODE_ENV=development, so PIN "live" EXPLICITLY on the live deployment — the
# sandbox/live base URLs (sandbox.wompi.co / production.wompi.co) are derived
# from this value; there is no WOMPI_BASE_URL.
WOMPI_ENVIRONMENT=sandbox
#
# The four keys, from the Wompi dashboard -> Desarrolladores, for the SAME
# environment as above. The schema checks the prefixes and refuses a key from
# the other environment:
#   sandbox: pub_test_…  prv_test_…  test_integrity_…  test_events_…
#   live:    pub_prod_…  prv_prod_…  prod_integrity_…  prod_events_…
#
# Public key: rides on every checkout URL, not a secret.
WOMPI_PUBLIC_KEY=pub_test_placeholder
# Private key: server only. Used to read GET /v1/transactions/{id} when the
# shopper returns from checkout and by the reconciliation sweep.
WOMPI_PRIVATE_KEY=prv_test_placeholder
# Integrity secret: signs the checkout URL (reference + amount + currency +
# expiration), so a shopper cannot edit the amount they are charged.
WOMPI_INTEGRITY_SECRET=test_integrity_placeholder
# Events secret: verifies X-Event-Checksum on POST /v1/webhooks/wompi. It is the
# ENTIRE security boundary on that route.
#
# HOW TO WIRE EVENTS: Wompi dashboard -> Desarrolladores -> "URL de Eventos" =
# https://<api-host>/v1/webhooks/wompi, set SEPARATELY in the sandbox and the
# production dashboards.
#
# Locally any test_events_… value works: the settlement path is testable by
# signing your own events with it (libs/testing: buildSignedWompiEvent).
WOMPI_EVENTS_SECRET=test_events_placeholder

# --- Email (docker compose: akai-mailpit) -----------------------------------
# TWO SETTINGS ONLY, AND ONE OF THEM DELIVERS NOTHING.
#
# `resend` sends real mail. ANY other value — `smtp` included — binds the
# LOGGING transport, which prints a line, returns a fabricated `local-000001`
# message id and DELIVERS NOTHING. Despite the name there is no SMTP adapter in
# apps/api/src/modules/email/adapters, and nothing anywhere reads SMTP_URL; it
# survives only because the schema still pairs it with `smtp` and every existing
# .env and fixture sets it. Mailpit is not wired to this and does not receive
# these messages.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=no-reply@example.com
# OPTIONAL — where a contact-form submission is delivered. Falls back to
# EMAIL_FROM when unset. Deliberately separate: EMAIL_FROM is the "From"
# address on EVERY transactional email (order confirmations, password resets
# included), so pointing it at a free mailbox to receive contact mail would
# route all of those through it too, with no SPF/DKIM alignment for that
# domain. Set this instead when the support inbox differs from the sender.
# CONTACT_INBOX_EMAIL=akai.contacto@gmail.com
# THE KEY AND THE TRANSPORT MOVE TOGETHER — the schema enforces it, in BOTH
# directions, and neither rule depends on NODE_ENV (this platform's API runs
# NODE_ENV=development in production on purpose, so a NODE_ENV-keyed rule never
# fires and silently discards every order confirmation):
#
#   * EMAIL_TRANSPORT=resend with no key  -> boot fails, naming RESEND_API_KEY.
#   * A NON-EMPTY key with any other transport -> boot fails, naming
#     EMAIL_TRANSPORT. Holding a sending credential and throwing mail away is
#     never intentional, so it is refused rather than logged.
#
# Leave it EMPTY (as below) until a key is issued: empty reads as "absent", which
# is the ordinary un-provisioned state and boots fine. The moment you paste a
# key in here, set EMAIL_TRANSPORT=resend in the same edit.
RESEND_API_KEY=
# OPTIONAL, and COMMENTED OUT on purpose: the schema is `.min(32).optional()`, so
# a bare `RESEND_WEBHOOK_SECRET=` is the empty string and fails validation.
#
# The Svix signing secret Resend shows when you add a webhook endpoint. WITHOUT
# IT, delivery status never advances past SENT: DELIVERED, BOUNCED and COMPLAINED
# are known only to the provider and arrive out of band at
# POST /v1/webhooks/resend, which refuses every delivery with 503 while this is
# unset. The admin email log marks such rows "awaiting provider" so the missing
# half is visible rather than silent.
# RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# --- Object storage (docker compose: akai-minio) ----------------------------
# Host port 9002 -> container 9000 (console 9003 -> 9001).
# These four are REQUIRED — the schema is min(1), so an empty value fails
# validation and the API will not boot. Credentials match docker-compose.yml.
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=akai-media
S3_ACCESS_KEY_ID=akaidev
S3_SECRET_ACCESS_KEY=akaidev-secret
# OPTIONAL, and read ONLY by `pnpm db:seed` (apps/api/src/seed/seed-media.ts).
# The seed uploads its fixture images to S3_ENDPOINT and records
# ${S3_ENDPOINT}/${S3_BUCKET}/${key} as their public URL. Set this when the
# address a WRITER reaches the bucket at is not the address a BROWSER reaches it
# at — seeding from inside docker compose (S3_ENDPOINT=http://minio:9000, which
# no browser can resolve), or a CDN in front of the bucket. Leave it out
# otherwise: unset is correct for a seed run from the host.
# SEED_MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/akai-media

# --- Origins -----------------------------------------------------------------
# 3100/3101 rather than 3000/3001, which are frequently already taken.
# Production refuses any plaintext http:// origin: session cookies are Secure
# and would never be sent.
# 3002 is the storefront E2E dev server (apps/storefront-e2e/playwright.config.ts).
# It is NOT optional since the WordPress cutover: the browser now calls /v1/cart,
# /v1/contact and /v1/shipping/quote DIRECTLY, so an origin missing from this list
# makes the cart unreachable in E2E — and the symptom is a silent "add to cart did
# nothing", not a CORS error anyone sees.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3002
STOREFRONT_URL=http://localhost:3100
DASHBOARD_URL=http://localhost:3101

# --- Misc --------------------------------------------------------------------
# Signed-header replacement for the old ?secret= query-string pattern. Min 32.
REVALIDATE_SIGNING_SECRET=change-me-to-at-least-32-random-characters
# Cloudflare Turnstile SECRET key (Turnstile dashboard -> your widget -> Secret
# key). Pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the storefront: the widget
# mints the token, this key verifies it. Set ONE without the other and the
# control does nothing useful — no site key means no legitimate customer can
# produce a token at all.
#
# REQUIRED THE MOMENT RESEND_API_KEY IS SET, in the same edit, and libs/config
# refuses to boot otherwise. Not a style rule: without this key both AuthModule
# and ContactModule bind AlwaysAllowCaptchaVerifier, which accepts ANY token
# string, so POST /v1/auth/register will mail a verification link to any address
# an attacker names — from your verified sending domain, one customer row per
# attempt. With no Resend key that mail is discarded by LoggingTransport, which
# is why blank is still allowed until then.
#
# The old rule ("required in production") is deliberately NOT the one that
# holds: the deployed API runs NODE_ENV=development on purpose, so that branch
# never fires. The credential is the signal, exactly as with EMAIL_TRANSPORT.
#
# Optional locally — leave empty or unset. Blank and whitespace both read as
# "not issued yet"; they never configure a half-on captcha.
TURNSTILE_SECRET_KEY=
# OPTIONAL URLs — keep these COMMENTED OUT unless you have a real value.
# An empty string fails .url() validation; only an absent variable is "unset".
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- apps/storefront (Astro, SSR) --------------------------------------------
# Read from process.env at REQUEST time, never baked into the build, so one
# image serves every environment. The storefront also reads API_INTERNAL_URL,
# SESSION_SECRET, SESSION_COOKIE_NAME (shared with the dashboard — one sealed
# cookie is one sign-in for both) and REVALIDATE_SIGNING_SECRET (above).
#
# How the BROWSER reaches the API: cart, shipping quote, checkout and the
# post-payment status poll go straight from islands to the API (its throttles
# key on the caller's address). No trailing slash.
PUBLIC_API_URL=http://localhost:3333
# The dashboard hosts sign-in, sign-up and the customer account; the header
# links there.
PUBLIC_DASHBOARD_URL=http://localhost:3101
# Used by the dashboard build (Next inlines it) — same value as PUBLIC_API_URL.
NEXT_PUBLIC_API_URL=http://localhost:3333
# The dashboard's "back to the store" link — the storefront's public origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- apps/dashboard ----------------------------------------------------------
API_INTERNAL_URL=http://localhost:3333
SESSION_COOKIE_NAME=akai_session
# AES-256-GCM key material for the sealed akai_session cookie. REQUIRED — the
# dashboard refuses to serve a request without it. Minimum 32 characters;
# generate with `openssl rand -base64 48`. Rotating this value invalidates every
# session in the fleet, which is the intended break-glass control.
SESSION_SECRET=change-me-to-at-least-32-random-characters
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
