{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/db/src",
  "tags": [
    "scope:server",
    "type:lib"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/db",
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "libs/db"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/db"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --schema prisma/schema.prisma",
        "cwd": "libs/db"
      }
    },
    "prisma-validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma validate --schema prisma/schema.prisma",
        "cwd": "libs/db"
      }
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --schema prisma/schema.prisma",
        "cwd": "libs/db"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --schema prisma/schema.prisma",
        "cwd": "libs/db"
      }
    }
  }
}
