    "check:no-any": "node tools/scripts/check-no-any.mjs",
    "db:seed": "nx run api:seed",
    "db:studio": "prisma studio --schema libs/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema libs/db/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "start:api": "nx run api:serve",
    "start:worker": "nx run worker:serve",
    "start:all": "nx run-many -t serve --parallel=4"
