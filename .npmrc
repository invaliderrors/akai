# eslint-config-next pulls its plugins (react-hooks, jsx-a11y, import,
# @next/eslint-plugin-next) as transitive deps. Under pnpm's isolated
# node_modules those are unreachable from the workspace root, so FlatCompat
# fails with "Cannot find module 'eslint-plugin-react-hooks'". Hoisting the
# eslint ecosystem to the root node_modules is pnpm's documented remedy.
public-hoist-pattern[]=*eslint-plugin*
public-hoist-pattern[]=*eslint-config*
public-hoist-pattern[]=@next/eslint-plugin-next

# Nx resolves executors and plugin packages from the workspace root.
public-hoist-pattern[]=@nx/*
